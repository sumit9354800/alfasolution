# ---------------------------------------------------------------------------
# Alfa Solution — environment configuration
# Copy this file to `.env.local` for local development (XAMPP),
# and enter the same keys in Hostinger's environment variables for production.
# Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MySQL / MariaDB) ---------------------------------------------
# Option A: individual values (XAMPP defaults shown — user "root", empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alfa_solution
# Option B: a single URL (takes priority if set)
# DATABASE_URL=mysql://u123456_alfa:password@localhost:3306/u123456_alfa
DB_CONNECTION_LIMIT=10

# --- Security ---------------------------------------------------------------
# Long random strings (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-48-chars
CAPTCHA_SECRET=change-me-to-another-long-random-string-48-chars

# Admin session length in hours
ADMIN_SESSION_HOURS=8

# --- First admin (only if you can't run `npm run admin:create`) -------------
# When no admin exists yet, opening /admin/login creates this super admin.
# Delete these three lines after your first sign-in.
# BOOTSTRAP_ADMIN_NAME=Nishant
# BOOTSTRAP_ADMIN_EMAIL=you@alfasolution.net
# BOOTSTRAP_ADMIN_PASSWORD=a-long-unique-password

# --- File storage -----------------------------------------------------------
# Where uploads (images, CVs) are stored. On Hostinger, point this OUTSIDE the
# deployed app folder so redeploys don't delete uploads, e.g. /home/u123456/alfa-storage
STORAGE_DIR=./storage

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Payments (Razorpay) ----------------------------------------------------
# Use rzp_test_… keys locally and rzp_live_… keys in production.
# The key secret and webhook secret are used on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=GTM-NCBHJ4NJ
